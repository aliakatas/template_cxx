{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-debug-configure",
            "type": "shell",
            "command": "cmake --preset debug",
            "group": "build"
        },
        {
            "label": "cmake-release-configure",
            "type": "shell",
            "command": "cmake --preset release",
            "group": "build"
        },
        {
            "label": "cmake-debug-build",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build/debug",
            "group": "build",
            "dependsOn": ["cmake-debug-configure"]
        },
        {
            "label": "cmake-release-build",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build/release",
            "group": "build",
            "dependsOn": ["cmake-release-configure"]
        }
    ]
}