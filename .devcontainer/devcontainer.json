{
    "name": "devbase",
    "build": {
        "dockerfile": "./containerfile.gcc",
        "context": "."
    },
    // or, instead of "build", use 
    // "image": "docker.io/aristos86/devbase:gcc13.3-clang18.1-ubu24.04-arm64" 
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-clangd"
            ]
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind"
    ],
    "workspaceFolder": "/workspace",
    "runArgs": [
        "--cap-add=SYS_PTRACE", 
        "--security-opt=no-new-privileges:true",
        "--security-opt=label=disable",
        "--security-opt=seccomp=unconfined",
        "--userns=keep-id"
    ]
}
